generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------
// User & Auth
// -----------------------------------------
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  role          Role      @default(CUSTOMER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bookings      Booking[]

  @@map("users")
}

enum Role {
  CUSTOMER
  ADMIN
}

// -----------------------------------------
// Vehicles & Inventory
// -----------------------------------------
model Vehicle {
  id           String             @id @default(uuid())
  make         String
  model        String
  year         Int
  category     String             // Sedan | SUV | Premium | Luxury | Utility
  description  String?
  seats        Int                @default(5)
  doors        Int                @default(4)
  transmission String             @default("Automatic") // Automatic | Manual
  fuelType     String             @default("Petrol")    // Petrol | Diesel | Hybrid | Electric
  luggage      Int                @default(3)
  dailyRate    Float
  location     String             // Australian city / airport hub
  status       VehicleStatus      @default(AVAILABLE)
  isActive     Boolean            @default(true)
  imageUrl     String?
  gallery      Json?              // string[] of image URLs
  features     Json?              // technical specifications and amenities
  
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  bookings     Booking[]
  maintenances VehicleMaintenance[]
  payments     Payment[]
  pricingRules PricingRule[]

  @@index([status, isActive])
  @@index([category])
  @@index([location])
  @@index([dailyRate])
  @@map("vehicles")
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  RENTED
  MAINTENANCE
  UNAVAILABLE
  INACTIVE
}

// -----------------------------------------
// Maintenance & Blocked Periods
// -----------------------------------------
model VehicleMaintenance {
  id          String        @id @default(uuid())
  vehicleId   String
  startDate   DateTime
  endDate     DateTime
  reason      String        // MAINTENANCE | DAMAGE | CLEANING | INSPECTION | ADMIN_HOLD
  notes       String?
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  vehicle     Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, startDate, endDate])
  @@map("vehicle_maintenances")
}

// -----------------------------------------
// Bookings
// -----------------------------------------
model Booking {
  id                  String        @id @default(uuid())
  bookingNumber       String        @unique
  userId              String
  vehicleId           String
  pickupLocation      String
  dropoffLocation     String
  pickupDate          DateTime
  dropoffDate         DateTime
  pickupTime          String        @default("10:00")
  returnTime          String        @default("10:00")
  rentalDays          Int           @default(1)
  dailyRate           Float
  baseAmount          Float
  extrasAmount        Float         @default(0)
  discountAmount      Float         @default(0)
  taxAmount           Float         @default(0)
  finalAmount         Float
  currency            String        @default("INR")
  promoCode           String?
  customerDetails     Json          // { name, email, phone, dob, licenseNumber, address }
  extras              Json?         // Array of selected extras { id, name, price, pricingType, quantity, total }
  status              BookingStatus @default(PENDING)
  paymentStatus       PaymentStatus @default(PENDING)
  razorpayOrderId     String?
  razorpayPaymentId   String?
  cancellationReason  String?
  cancelledAt         DateTime?
  
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  user                User          @relation(fields: [userId], references: [id])
  vehicle             Vehicle       @relation(fields: [vehicleId], references: [id])
  payments            Payment[]

  @@index([vehicleId, pickupDate, dropoffDate, status])
  @@index([userId])
  @@index([bookingNumber])
  @@index([status])
  @@map("bookings")
}

enum BookingStatus {
  PENDING
  PAYMENT_PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  REFUNDED
  EXPIRED
}

// -----------------------------------------
// Discounts & Promotions
// -----------------------------------------
model Discount {
  id                   String        @id @default(uuid())
  code                 String        @unique
  description          String?
  discountType         DiscountType  @default(PERCENTAGE)
  value                Float         // e.g. 10 for 10%, 50 for 50 flat
  minBookingValue      Float?
  minRentalDays        Int?
  maxDiscountAmount    Float?
  usageLimit           Int?
  usageCount           Int           @default(0)
  perCustomerLimit     Int?          @default(1)
  startDate            DateTime?
  endDate              DateTime?
  isActive             Boolean       @default(true)
  applicableCategories Json?         // string[]
  applicableVehicles   Json?         // string[]

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([code, isActive])
  @@map("discounts")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

// -----------------------------------------
// Optional Rental Extras
// -----------------------------------------
model Extra {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  pricingType ExtraPricingType @default(PER_DAY)
  price       Float
  icon        String?
  isActive    Boolean          @default(true)
  maxQuantity Int              @default(1)

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([code, isActive])
  @@map("extras")
}

enum ExtraPricingType {
  PER_DAY
  FLAT
}

// -----------------------------------------
// Rental Locations
// -----------------------------------------
model Location {
  id               String   @id @default(uuid())
  code             String   @unique
  name             String
  airportOrCity    String
  address          String
  state            String
  pickupAvailable  Boolean  @default(true)
  dropoffAvailable Boolean  @default(true)
  isActive         Boolean  @default(true)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([code, isActive])
  @@map("locations")
}

// -----------------------------------------
// Dynamic Pricing Rules
// -----------------------------------------
model PricingRule {
  id          String          @id @default(uuid())
  name        String
  vehicleId   String?
  category    String?
  location    String?
  ruleType    PricingRuleType @default(DAILY_OVERRIDE)
  adjustment  Float
  startDate   DateTime?
  endDate     DateTime?
  priority    Int             @default(0)
  isActive    Boolean         @default(true)

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  vehicle     Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, category, isActive])
  @@map("pricing_rules")
}

enum PricingRuleType {
  DAILY_OVERRIDE
  WEEKEND_SURCHARGE
  SEASONAL
  LOCATION_SURCHARGE
}

// -----------------------------------------
// Payments (Razorpay Integration)
// -----------------------------------------
model Payment {
  id                String        @id @default(uuid())
  bookingId         String?
  vehicleId         String?
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  amount            Float         // Authoritative amount in major currency unit (e.g. INR)
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  receipt           String?
  notes             Json?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  booking           Booking?      @relation(fields: [bookingId], references: [id])
  vehicle           Vehicle?      @relation(fields: [vehicleId], references: [id])

  @@index([status])
  @@index([bookingId])
  @@index([vehicleId])
  @@map("payments")
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

// -----------------------------------------
// Audit Logs
// -----------------------------------------
model AuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  entity    String
  entityId  String
  details   Json?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([adminId, createdAt])
  @@map("audit_logs")
}
